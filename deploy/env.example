# Copier vers /var/lib/revision-app/env (chmod 600, propriétaire revision). Ne jamais le mettre dans git.
PORT=8650
PUBLIC_URL=https://revision.funnelforge.fr
# Client OAuth Google de type « Application Web », redirection : PUBLIC_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 octets en base64 : openssl rand -base64 32   (chiffre les jetons Google ; ne pas le perdre)
ENC_KEY=
DATA_DIR=/var/lib/revision-app
MAX_USERS=10
# Fuseau pour « aujourd'hui » (cartes dues, contrôles)
TIMEZONE=Europe/Paris
